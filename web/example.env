
# Application
VITE_APP_NAME=Club Gate Access
VITE_MAGICSTACK_IMAGINARY_API=https://imaginary.magicrunez.com
VITE_MAGICSTACK_FILES_API=https://files.magicrunez.com

# Auth / tenant
VITE_TENANT_ID=
VITE_MAGICSTACK_AUTH_API=https://auth.magicrunez.com

# Backend API
# Production builds always use VITE_API_URL. `npm run dev` uses VITE_LOCAL_API_URL,
# unless VITE_USE_LOCAL_API=false (run the local front end against the deployed API).
VITE_USE_LOCAL_API=true
VITE_LOCAL_API_URL=http://localhost:3040
VITE_API_URL=https://mcsagate.magicrunez.com
